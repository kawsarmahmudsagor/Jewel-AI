      "9_cadReconstructionParameters": {
        "title": "CAD Reconstruction Parameters",
        "perComponent": {
          "componentName": "Solitaire Engagement Ring",
          "position": {
            "x": 0,
            "y": 0,
            "z": 0
          },
          "rotation": {
            "rx": 0,
